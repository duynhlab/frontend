# Local development + Playwright. Loaded by `vite dev` only — never by
# `vite build`, so nothing here can leak into a released image.
#
# Points at the local-stack containers: the Envoy Gateway edge on :8080 and
# Keycloak on :8081 (`cd ../homelab/local-stack && docker compose up -d`).
VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=duynhlab
VITE_KEYCLOAK_CLIENT_ID=customer-spa
