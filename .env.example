# Frontend Environment Variables

# Mock Mode Toggle
# true = In-memory mock APIs + mock Keycloak adapter — no gateway or Keycloak
#        required (a fake `alice` session, no password)
# false = Use real API (requires VITE_API_BASE_URL)
VITE_USE_MOCK=false

# API Base Domain (without /api/v1 - that's handled by the app)
# Only needed when VITE_USE_MOCK=false
# Development: http://localhost:8080
# Production: https://api.domain.com
VITE_API_BASE_URL=http://localhost:8080

# Keycloak OIDC (login redirect; demo account alice / password123)
# Development: http://localhost:8081 (local-stack)  Production: https://id.duynh.me
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=duynhlab
VITE_KEYCLOAK_CLIENT_ID=customer-spa
