# Frontend Environment Variables
#
# There is no mock mode. Every screen talks to the real gateway; bring the
# stack up with `cd ../homelab/local-stack && docker compose up -d`.

# Gateway origin (each api module owns its /{service}/v1/{audience} prefix).
# Development: http://localhost:8080   Production: https://gateway.duynh.me
VITE_API_BASE_URL=http://localhost:8080

# Keycloak OIDC (login redirect; demo account alice / password123, by username)
# Development: http://localhost:8081 (local-stack)  Production: https://id.duynh.me
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=duynhlab
VITE_KEYCLOAK_CLIENT_ID=customer-spa
