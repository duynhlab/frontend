*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
e2e/.auth/
playwright-report/
playwright-report-*/
test-results/
test-results-*/

# Cache
.cache/
.eslintcache
*.tsbuildinfo

