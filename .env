# Frontend Environment Variables — the cloud baseline for a plain `npm run
# build` outside Docker. The image build never sees this file (.dockerignore
# excludes it); there the value comes from the API_BASE_URL build arg, or from
# the in-code default in src/lib/api.ts when the arg is unset.
#
# Local development and Playwright read .env.development, which Vite loads for
# `vite dev` only.

# Gateway origin. Each api module owns its own /{service}/v1/{audience} prefix.
VITE_API_BASE_URL=https://gateway.duynh.me
